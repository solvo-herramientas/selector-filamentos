{
  "name": "selector-filamentos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.19.x",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
